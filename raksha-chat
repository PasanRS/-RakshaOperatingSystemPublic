def llm_stream(messages: list, use_nvidia: bool = False):
    """Yield text tokens from LLM stream."""
    if use_nvidia and NVIDIA_KEY:
        url = f"{NVIDIA_URL}/chat/completions"
        headers = {"Content-Type": "application/json",
                   "Authorization": f"Bearer {NVIDIA_KEY}"}
        payload = {"model": NVIDIA_MODEL, "messages": messages,
                   "max_tokens": 1024, "temperature": 0.9, "stream": True}
    else:
        url = LLAMA_URL
        headers = {"Content-Type": "application/json"}
        payload = {"model": LLAMA_MODEL, "messages": messages,
                   "max_tokens": 1024, "temperature": 0.7, "stream": True}

    req = urllib.request.Request(url, json.dumps(payload).encode(), headers)
    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            for raw_line in resp:
                line = raw_line.decode().strip()
                if not line.startswith("data:"):
                    continue
                chunk = line[5:].strip()
                if chunk == "[DONE]":
                    return
                try:
                    delta = json.loads(chunk)["choices"][0]["delta"]
                    content = delta.get("content", "")
                    if content:
                        yield content
                except Exception:
                    continue
    except Exception as e:
        yield f" Error: {e}"

