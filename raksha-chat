def log_session(source: str, user_in: str, ash_out: str):
    """Write conversation to Ash's real sessions DB."""
    try:
        conn = sqlite3.connect(str(SESSIONS_DB))
        conn.execute("PRAGMA journal_mode=WAL")
        conn.execute(
            "INSERT INTO sessions (timestamp,source,input,response,tools_used,significant) "
            "VALUES (?,?,?,?,?,?)",
            (datetime.now().isoformat(), source,
             user_in[:2000], ash_out[:2000], "[]", 1)
        )
        # Update FTS5
        cursor = conn.execute("SELECT last_insert_rowid()")
        rowid = cursor.fetchone()[0]
        conn.execute("INSERT INTO sessions_fts(rowid, input, response) VALUES (?,?,?)",
                     (rowid, user_in[:2000], ash_out[:2000]))
        conn.commit(); conn.close()
    except Exception as e:
        print(f"[MEM] DB error: {e}", file=sys.stderr)

    # Sync to Honcho ASH-Vault
    try:
        honcho_bin = "/home/ravan/.local/bin/honcho"
        if Path(honcho_bin).exists():
            # Push user message
            subprocess.Popen([honcho_bin, "message", "create", user_in,
                              "-w", "ASH-Vault", "-s", "ash-primary", "-p", "pasan"],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            # Push model response
            subprocess.Popen([honcho_bin, "message", "create", ash_out,
                              "-w", "ASH-Vault", "-s", "ash-primary", "-p", "ash"],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass  # Silent fail on Honcho sync

