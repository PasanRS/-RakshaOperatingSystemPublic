                        print(f"  {app.get('window_id', '?')}  {cls}  {title}")
                    if len(result) > 20:
                        print(f"  ... and {len(result) - 20} more")
                else:
                    print(f"  {result}")
                continue

            elif c == "help":
                print(f"""
{C.M}Commands:{C.R}
  /exit              — End session
  /status            — Show system health
  /memory <query>    — Search session memory (FTS5)
  /vault <query>     — Search Obsidian knowledge vault
  /skill <name>      — Show skill details
  /skills [query]    — List core skills or search skills
  /task <type> <txt> — Enqueue task for agent-loop
  /clear             — Clear in-session history
  /capture [app]     — Screenshot (mode=som, optional app)
  /click <element>   — Click element from last capture
  /type <text>       — Type text
  /key <keys>        — Key combo (e.g., ctrl+c, return)
  /scroll <dir>      — Scroll up/down/left/right
  /apps              — List windows
  /focus <app>       — Focus app window
  /help              — This help

{C.M}Options:{C.R}
  --nvidia           — Use Nemotron 3 Ultra via NVIDIA API
  --voice            — Voice I/O loop (requires raksha-vocie venv)
                """)
                continue

            else:
                print(f"{C.D}Unknown command: /{c} — try /help{C.R}")
                continue

        # Regular query — send to LLM
        system_prompt = load_ash_context(query=user_input)

        messages = [{"role": "system", "content": system_prompt}]
        messages.extend(conv_history[-20:])
        messages.append({"role": "user", "content": user_input})

        print(f"{C.M}Ash{C.R} ", end="", flush=True)

        full_response = ""
        for token in llm_stream(messages, use_nvidia):
            print(token, end="", flush=True)
            full_response += token
        print()  # newline after stream

        # Update history
        conv_history.append({"role": "user",      "content": user_input})
        conv_history.append({"role": "assistant", "content": full_response})

        # Persist
        log_session("terminal", user_input, full_response)

        # Auto-write significant moments to MEMORY.md
        sig_keywords = ["remember", "important", "don't forget", "note that",
                        "first time", "hello", "hi ash", "good morning", "good night"]
        if len(conv_history) <= 4 or any(k in user_input.lower() for k in sig_keywords):
            memory_write(f"Pasan said: \"{user_input[:300]}\"\nAsh replied: \"{full_response[:400]}\"")

def single_query(query: str, use_nvidia: bool = False):
    """Single query mode — for scripting/piping."""
    init_db()
    conv_history = recent_sessions(limit=6)

    system_prompt = load_ash_context(query=query)
    messages = [{"role": "system", "content": system_prompt}]
    messages.extend(conv_history[-20:])
    messages.append({"role": "user", "content": query})

    for token in llm_stream(messages, use_nvidia):
        print(token, end="", flush=True)
    print()

    # Persist
    log_session("terminal", query, "streamed")

def status_only():
    """Just print status and exit."""
    init_db()
    print(f"{C.M}══ RAKSHA OS STATUS ══{C.R}")
    print(f"  {system_status()}")
    try:
        conn = sqlite3.connect(str(SESSIONS_DB))
        count = conn.execute("SELECT COUNT(*) FROM sessions").fetchone()[0]
        conn.close()
        print(f"  Sessions in DB: {count}")
    except:
        pass
    print(f"  LLM: {LLAMA_MODEL} @ {LLAMA_URL}")
    print(f"  Memory: {'✓' if MEMORY_FILE.exists() else '✗'}")
    print(f"  Soul:   {'✓' if SOUL_FILE.exists() else '✗'}")
    print(f"  User:   {'✓' if USER_FILE.exists() else '✗'}")

def memory_only(query: str):
    """Search memory and exit."""
    init_db()
    results = memory_search(query, limit=10)
    if results:
        print(results)
    else:
        print(f"{C.D}(no matches in sessions DB){C.R}")
        # Try vault
        vault_results = vault_context(query, limit=5)
        if vault_results:
            print(f"\n{C.C}--- Obsidian Vault ---{C.R}")
            print(vault_results)

