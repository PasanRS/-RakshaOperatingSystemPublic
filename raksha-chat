def enqueue_task(task_type: str, content: str, priority: int = 5):
    """Enqueue a task for Ash's agent-loop to process."""
    try:
        conn = sqlite3.connect(str(TASK_DB))
        conn.execute("PRAGMA journal_mode=WAL")
        conn.execute(
            "INSERT INTO task_queue (created_at,type,content,source,priority) "
            "VALUES (?,?,?,?,?)",
            (datetime.now().isoformat(), task_type, content, "terminal", priority)
        )
        conn.commit(); conn.close()
        print(f"{C.D}[TASK] Enqueued: {task_type}: {content[:60]}{C.R}")
    except Exception as e:
        print(f"[TASK] Error: {e}", file=sys.stderr)

