def main():
    parser = argparse.ArgumentParser(
        description="Raksha OS Terminal Gateway — Direct line to Ash Core",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  raksha-chat                    # Interactive REPL
  raksha-chat "system status"    # Single query
  raksha-chat --nvidia "deep analysis"  # Use Nemotron
  raksha-chat --status           # Quick health check
  raksha-chat --memory "factory" # Search session memory
        """
    )
    parser.add_argument("query", nargs="*", help="Single query (non-interactive)")
    parser.add_argument("--nvidia", action="store_true", help="Use NVIDIA Nemotron model")
    parser.add_argument("--voice", action="store_true", help="Voice I/O loop (not yet implemented)")
    parser.add_argument("--status", action="store_true", help="Show system status and exit")
    parser.add_argument("--memory", metavar="QUERY", help="Search session memory and exit")
    args = parser.parse_args()

    if args.status:
        status_only()
        return

    if args.memory:
        memory_only(args.memory)
        return

    if args.query:
        single_query(" ".join(args.query), use_nvidia=args.nvidia)
        return

    # Interactive REPL
    repl(use_nvidia=args.nvidia)

if __name__ == "__main__":
    main()