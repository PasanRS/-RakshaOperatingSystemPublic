[Unit]
Description=Ash Core — Native reasoning loop
After=llama-server.service
Wants=llama-server.service

[Service]
Type=oneshot
User=ravan
ExecStart=/usr/local/bin/ash --once
Environment=ASH_HOME=/var/lib/ash
Environment=LLAMA_URL=http://127.0.0.1:8080/v1/chat/completions
StandardOutput=append:/var/lib/ash/logs/ash.log
StandardError=append:/var/lib/ash/logs/ash.log
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
