[Unit]
Description=Raksha OS Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ravan
WorkingDirectory=/opt/raksha-dashboard
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/bin:/usr/bin:/bin
Environment=HONCHO_URL=http://localhost:8000
Environment=HONCHO_WORKSPACE=raksha-os
Environment=LLAMA_URL=http://localhost:8080
ExecStart=/home/ravan/.local/bin/uvicorn main:app --host 0.0.0.0 --port 8090
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target